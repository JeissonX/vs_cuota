{
  "name": "agpro-quota",
  "displayName": "AG Pro Quota — Antigravity Model Quota Monitor",
  "description": "Monitor de cuota de modelos y estado en tiempo real para Antigravity IDE.",
  "version": "1.1.0",
  "publisher": "agpro",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onView:agpro.dashboardView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agpro-quota-sidebar",
          "title": "AG Pro Quota",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agpro-quota-sidebar": [
        {
          "type": "webview",
          "id": "agpro.dashboardView",
          "name": "Cuota y Métricas"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agPro.openDashboard",
          "when": "view == agpro.dashboardView",
          "group": "navigation@1"
        },
        {
          "command": "agPro.refresh",
          "when": "view == agpro.dashboardView",
          "group": "navigation@2"
        }
      ]
    },
    "commands": [
      {
        "command": "agPro.openDashboard",
        "title": "AG Pro: Abrir Dashboard de Cuota",
        "icon": "$(dashboard)"
      },
      {
        "command": "agPro.refresh",
        "title": "AG Pro: Refrescar Cuota",
        "icon": "$(refresh)"
      },
      {
        "command": "agPro.quickOverview",
        "title": "AG Pro: Vista Rápida de Cuota",
        "icon": "$(graph)"
      },
      {
        "command": "agPro.diagnose",
        "title": "AG Pro: Diagnóstico de Conexión",
        "icon": "$(output)"
      },
      {
        "command": "agPro.toggleLang",
        "title": "AG Pro: Cambiar Idioma (ES/EN)",
        "icon": "$(globe)"
      },
      {
        "command": "agPro.openSettings",
        "title": "AG Pro: Abrir Configuración",
        "icon": "$(gear)"
      },
      {
        "command": "agPro.togglePoolView",
        "title": "AG Pro: Cambiar Vista de Pools (Ambos / Gemini / Claude)",
        "icon": "$(eye)"
      }
    ],
    "configuration": {
      "title": "AG Pro Quota",
      "properties": {
        "agPro.refreshIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 3600,
          "description": "Intervalo de refresco automático en segundos (mínimo 5s)."
        },
        "agPro.statusBarFormat": {
          "type": "string",
          "default": "standard",
          "enum": ["icon", "dot", "percent", "compact", "namePercent", "standard"],
          "enumDescriptions": [
            "Solo icono 🚀",
            "Solo indicador de estado 🟢🟡🔴",
            "Solo porcentaje: 65%",
            "Indicador + porcentaje: 🟢 65%",
            "Nombre + porcentaje: Modelo: 65%",
            "Completo: 🟢 Modelo: 65% (por defecto)"
          ],
          "description": "Formato de la barra de estado."
        },
        "agPro.statusBar.showWindows": {
          "type": "string",
          "default": "both",
          "enum": ["both", "binding"],
          "enumDescriptions": [
            "Mostrar ambas ventanas: 5h y semanal (ej: 93%/94%)",
            "Mostrar únicamente la ventana limitante o menor (ej: 93%)"
          ],
          "description": "Determina si se muestran ambas ventanas de cuota o solo la ventana restrictiva en la barra de estado."
        },
        "agPro.statusBar.pools": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Lista de pools a mostrar en la barra de estado (vacío para mostrar todos los pools disponibles)."
        },
        "agPro.statusBar.poolView": {
          "type": "string",
          "default": "all",
          "enum": ["all", "gemini", "claude"],
          "enumDescriptions": [
            "Mostrar ambos pools: Gemini y Claude",
            "Mostrar únicamente el pool Gemini",
            "Mostrar únicamente el pool Claude / GPT"
          ],
          "description": "Filtro de visualización de pools en la barra de estado."
        },
        "agPro.warningThreshold": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 99,
          "description": "Porcentaje bajo el cual se muestra advertencia amarilla."
        },
        "agPro.criticalThreshold": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 99,
          "description": "Porcentaje bajo el cual se muestra alerta roja."
        },
        "agPro.language": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "es", "en"],
          "description": "Idioma de la extensión."
        },
        "agPro.pinnedModels": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Modelos fijados en la barra de estado."
        },
        "agPro.notificationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar notificaciones al cruzar umbrales de cuota."
        },
        "agPro.logLevel": {
          "type": "string",
          "default": "info",
          "enum": ["debug", "info", "warn", "error"],
          "description": "Nivel de detalle del log."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "node --import tsx --test test/**/*.test.ts",
    "package": "npx -y @vscode/vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
